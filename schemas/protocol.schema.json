{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymentauth.org/schemas/protocol.schema.json",
  "title": "MPP Conformance Protocol Values",
  "$comment": "Each pattern sits beside a not that rejects a line terminator anywhere in the value. ECMA-262 $ matches only at the end of the string, but Python's re (used by the jsonschema package) also matches it before a final LF, java.util.regex before a final CR, CRLF, LF, NEL, LS or PS, and Ruby's Regexp (json_schemer) lets ^ and $ match at every line, so one valid line could carry others; the unanchored not keeps all of those out (CR and LF only for ParamValue, which allows NEL, LS and PS as content), without a lookahead, which RE2-based validators (Go, the Rust regex crate) cannot compile. Control characters in classes are JSON escapes, not regex \\u escapes, for the same reason.",
  "$defs": {
    "IntentId": {
      "description": "core intent = 1*( ALPHA / DIGIT / \"-\" )",
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" }
    },
    "PaymentMethodId": {
      "description": "core payment-method-id = 1*LOWERALPHA",
      "type": "string",
      "pattern": "^[a-z]+$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" }
    },
    "Operation": {
      "type": "string",
      "enum": [
        "challenge.parse",
        "challenge.format",
        "credential.parse",
        "credential.format",
        "receipt.parse",
        "receipt.format",
        "base64url.encode",
        "base64url.decode",
        "challenge.id",
        "server.verify",
        "tempo.fee_payer.cosign",
        "tempo.receipt.verify",
        "tempo.proof.typed_data",
        "tempo.proof.verify",
        "http.payment_request",
        "http.server",
        "stripe.external_id_binding"
      ]
    },
    "ErrorType": {
      "type": "string",
      "enum": [
        "parse_error",
        "format_error",
        "encoding_error",
        "generation_error",
        "verification_error",
        "http_error",
        "unsupported_operation",
        "unknown_error"
      ]
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": true
    },
    "Opaque": {
      "description": "Core draft opaque parameter: base64url without padding (RFC 4648 Section 5) of a JCS-serialized JSON object whose values are strings. The pattern and minLength check the encoding (non-empty, no length that leaves a lone character, which no byte string encodes to, and zero unused bits in the last character, so each byte string has exactly one accepted encoding); the content keywords describe the decoded value, which validators only annotate, so consumers decode and check it.",
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" },
      "minLength": 2,
      "contentEncoding": "base64url",
      "contentMediaType": "application/json",
      "contentSchema": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "DateTime": {
      "description": "RFC 3339 date-time, as the core draft requires for Challenge expires and Receipt timestamp. format: date-time is an annotation by default in JSON Schema 2020-12, so the pattern enforces it in every validator (RE2-compatible; T and Z are case-insensitive per RFC 3339 section 5.6). The date branch checks each month's length and allows February 29 only in Gregorian leap years (RFC 3339 section 5.7). Second 60 (a leap second) falls at 23:59:60 UTC on the last day of a month (February 28 only outside leap years) (RFC 3339 section 5.7): with offset Z or +00:00/-00:00 the pattern accepts exactly that. With any other offset the pattern rejects second 60: a pattern cannot tie the local time to its offset, and MPP implementations write timestamps in UTC.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])|(?:(?:[0-9]{4}-(?:(?:0[13578]|1[02])-31|(?:0[469]|11)-30)|(?:[0-9]{2}(?:[02468][1235679]|[13579][01345789])|(?:[02468][1235679]|[13579][01345789])00)-02-28)|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)[Tt]23:59:60(?:\\.[0-9]+)?(?:[Zz]|[+-]00:00))$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" }
    },
    "ContentDigest": {
      "description": "RFC 9530 Content-Digest field value, as the core draft requires for Challenge digest: a Structured Fields Dictionary (RFC 8941) of algorithm keys to byte sequences, such as sha-256=:...:, without parameters. Each byte sequence is base64 that decodes (whole 4-character groups, then 2 or 3 characters with optional padding), since RFC 8941 parsers reject other lengths and misplaced padding.",
      "type": "string",
      "pattern": "^[a-z*][a-z0-9_.*-]*=:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}(?:==)?|[A-Za-z0-9+/]{3}=?)?:(?:[ \t]*,[ \t]*[a-z*][a-z0-9_.*-]*=:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}(?:==)?|[A-Za-z0-9+/]{3}=?)?:)*$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" }
    },
    "ParamValue": {
      "description": "An auth-param value after token or quoted-string decoding (RFC 9110): no control characters but HTAB, since neither grammar can carry CR, LF or another one.",
      "type": "string",
      "pattern": "^[^\u0000-\u0008\u000A-\u001F\u007F]*$", "not": { "pattern": "[\r\n]" }
    },
    "Challenge": {
      "type": "object",
      "propertyNames": { "description": "RFC 9110 token, lowercase (core draft auth-param syntax and lowercase parameter names)", "pattern": "^[!#$%&'*+.^_`|~0-9a-z-]+$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" } },
      "required": ["id", "realm", "method", "intent", "request"],
      "additionalProperties": { "$ref": "#/$defs/ParamValue" },
      "properties": {
        "id": { "$ref": "#/$defs/ParamValue", "minLength": 1 },
        "realm": { "$ref": "#/$defs/ParamValue" },
        "method": { "$ref": "#/$defs/PaymentMethodId" },
        "intent": { "$ref": "#/$defs/IntentId" },
        "request": { "$ref": "#/$defs/JsonObject" },
        "expires": { "allOf": [{ "$ref": "#/$defs/ParamValue" }, { "$ref": "#/$defs/DateTime" }] },
        "description": { "$ref": "#/$defs/ParamValue" },
        "digest": { "allOf": [{ "$ref": "#/$defs/ParamValue" }, { "$ref": "#/$defs/ContentDigest" }] },
        "header": { "const": "Payment-Authorization" },
        "opaque": { "$ref": "#/$defs/Opaque" }
      }
    },
    "Credential": {
      "type": "object",
      "required": ["challenge", "payload"],
      "additionalProperties": true,
      "properties": {
        "challenge": { "$ref": "#/$defs/Challenge" },
        "payload": { "$ref": "#/$defs/JsonObject" },
        "source": { "type": "string" }
      }
    },
    "Receipt": {
      "type": "object",
      "required": ["status", "method", "timestamp", "reference"],
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string", "const": "success" },
        "method": { "$ref": "#/$defs/PaymentMethodId" },
        "timestamp": { "$ref": "#/$defs/DateTime" },
        "reference": { "type": "string", "minLength": 1 },
        "externalId": { "type": "string" },
        "subscriptionId": { "description": "Unpadded base64url (RFC 4648 Section 5), as the subscription intent requires: the Opaque encoding check without its JSON content.", "type": "string", "minLength": 2, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" } },
        "extra": { "$ref": "#/$defs/JsonObject" }
      }
    },
    "HeaderInput": {
      "type": "object",
      "required": ["header"],
      "additionalProperties": false,
      "properties": {
        "header": { "type": "string" }
      }
    },
    "HeaderOutput": {
      "type": "object",
      "required": ["header"],
      "additionalProperties": false,
      "properties": {
        "header": { "type": "string" }
      }
    },
    "TextValue": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" }
      }
    },
    "ChallengeIdInput": {
      "type": "object",
      "required": ["secretKey", "realm", "method", "intent", "request"],
      "additionalProperties": false,
      "properties": {
        "secretKey": { "type": "string", "minLength": 1 },
        "realm": { "type": "string" },
        "method": { "$ref": "#/$defs/PaymentMethodId" },
        "intent": { "$ref": "#/$defs/IntentId" },
        "request": { "$ref": "#/$defs/JsonObject" },
        "expires": { "type": "string" },
        "description": { "type": "string" },
        "digest": { "type": "string" },
        "header": { "const": "Payment-Authorization" },
        "opaque": { "$ref": "#/$defs/Opaque" }
      }
    },
    "ChallengeIdOutput": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "StripeExternalIdBindingInput": {
      "type": "object",
      "required": ["request", "payload", "paymentIntent"],
      "additionalProperties": false,
      "properties": {
        "request": { "$ref": "#/$defs/JsonObject" },
        "payload": { "$ref": "#/$defs/JsonObject" },
        "paymentIntent": {
          "type": "object",
          "required": ["id", "status"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "minLength": 1 },
            "replayed": { "type": "boolean" }
          }
        }
      }
    },
    "StripeExternalIdBindingResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "receipt"],
          "additionalProperties": false,
          "properties": {
            "ok": { "const": true },
            "receipt": { "$ref": "#/$defs/Receipt" }
          }
        },
        {
          "type": "object",
          "required": ["ok", "errorType"],
          "additionalProperties": false,
          "properties": {
            "ok": { "const": false },
            "errorType": { "enum": ["invalid_challenge", "verification_failed"] }
          }
        }
      ]
    },
    "TempoProofInput": {
      "type": "object",
      "required": ["account", "chainId", "challengeId", "realm"],
      "additionalProperties": false,
      "properties": {
        "account": { "$ref": "#/$defs/Address" },
        "chainId": { "type": "integer", "minimum": 0 },
        "challengeId": { "type": "string", "minLength": 1 },
        "realm": { "type": "string" }
      }
    },
    "TempoProofTypedData": {
      "type": "object",
      "required": ["domain", "types", "primaryType", "message"],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "object",
          "required": ["name", "version", "chainId"],
          "additionalProperties": false,
          "properties": {
            "name": { "const": "MPP" },
            "version": { "const": "3" },
            "chainId": { "type": "integer", "minimum": 0 }
          }
        },
        "types": {
          "const": {
            "Proof": [
              { "name": "account", "type": "address" },
              { "name": "challengeId", "type": "string" },
              { "name": "realm", "type": "string" }
            ]
          }
        },
        "primaryType": { "const": "Proof" },
        "message": {
          "type": "object",
          "required": ["account", "challengeId", "realm"],
          "additionalProperties": false,
          "properties": {
            "account": { "$ref": "#/$defs/Address" },
            "challengeId": { "type": "string", "minLength": 1 },
            "realm": { "type": "string" }
          }
        }
      }
    },
    "HttpPaymentMode": {
      "type": "string",
      "enum": [
        "payment",
        "plain",
        "invalid_payload",
        "mismatched_request",
        "invalid_challenge_id"
      ]
    },
    "HttpPaymentRequest": {
      "type": "object",
      "required": ["url", "method", "headers", "body", "payment", "mode"],
      "additionalProperties": false,
      "properties": {
        "url": { "description": "Absolute http or https URL: RFC 3986 authority (a non-empty host, an IP literal in brackets: an RFC 3986 IPv6address, without a zone, or IPvFuture), then path, query and fragment, with every % starting a two-digit escape. format: uri is an annotation by default in JSON Schema 2020-12, so the pattern enforces it in every validator (RE2-compatible).", "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?:(?:[A-Za-z0-9._~!$&'()*+,;=:-]|%[0-9A-Fa-f]{2})*@)?(?:\\[(?:(?:(?:[0-9A-Fa-f]{1,4}:){6}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|::(?:[0-9A-Fa-f]{1,4}:){5}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){4}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,1}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){3}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,2}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){2}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,4}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4})?::)|[Vv][0-9A-Fa-f]+\\.[A-Za-z0-9._~!$&'()*+,;=:-]+)\\]|(?:[A-Za-z0-9._~!$&'()*+,;=-]|%[0-9A-Fa-f]{2})+)(?::[0-9]*)?(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2}|/)*)?(?:\\?(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2}|[/?])*)?(?:#(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2}|[/?])*)?$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" } },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "payment": {
          "type": "object",
          "required": ["payload"],
          "additionalProperties": false,
          "properties": {
            "payload": { "$ref": "#/$defs/JsonObject" },
            "source": { "type": ["string", "null"] }
          }
        },
        "mode": { "$ref": "#/$defs/HttpPaymentMode" }
      }
    },
    "HttpResponse": {
      "type": "object",
      "required": ["status", "headers", "body"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": { "type": "string" }
      }
    },
    "HttpServerOffer": {
      "description": "An offer in the conformance http.server adapter command (mpp-tools conformance/schemas/protocol.schema.json), not a general charge request: adapters serve only amount, currency and recipient, so the request is closed to those three and other draft fields are out of scope here.",
      "type": "object",
      "required": ["method", "intent", "request"],
      "additionalProperties": false,
      "properties": {
        "method": { "$ref": "#/$defs/PaymentMethodId" },
        "intent": { "const": "charge" },
        "request": {
          "type": "object",
          "required": ["amount", "currency", "recipient"],
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "string", "minLength": 1 },
            "currency": { "type": "string", "minLength": 1 },
            "recipient": { "type": "string", "minLength": 1 }
          }
        },
        "expires": { "$ref": "#/$defs/DateTime" },
        "meta": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "HttpServerRoute": {
      "type": "object",
      "required": ["path", "offers"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" } },
        "offers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/HttpServerOffer" }
        },
        "echoHeaders": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" } }
        }
      }
    },
    "HttpServerConfig": {
      "type": "object",
      "required": ["port", "realm", "secretKey", "routes"],
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "realm": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string", "minLength": 32 },
        "requiresAuth": { "type": "boolean" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/HttpServerRoute" }
        }
      }
    },
    "HttpServerInfo": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" } }
      }
    },
    "ServerVerifyRequest": {
      "type": "object",
      "required": ["realm", "secretKey", "method", "intent", "request", "credential"],
      "additionalProperties": false,
      "properties": {
        "realm": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 },
        "method": { "$ref": "#/$defs/PaymentMethodId" },
        "intent": { "$ref": "#/$defs/IntentId" },
        "request": { "$ref": "#/$defs/JsonObject" },
        "expires": { "type": "string" },
        "verificationError": { "type": "string" },
        "credential": { "$ref": "#/$defs/Credential" }
      }
    },
    "ServerVerifyResult": {
      "type": "object",
      "required": ["ok"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "errorType": {
          "type": "string",
          "enum": [
            "malformed_credential",
            "invalid_challenge",
            "payment_expired",
            "verification_failed",
            "unknown_error"
          ]
        },
        "receipt": { "$ref": "#/$defs/Receipt" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "required": ["receipt"],
            "not": { "required": ["errorType"] }
          }
        },
        {
          "if": {
            "properties": { "ok": { "const": false } },
            "required": ["ok"]
          },
          "then": {
            "required": ["errorType"],
            "not": { "required": ["receipt"] }
          }
        }
      ]
    },
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" }
    },
    "HexValue": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]*$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" }
    },
    "UintValue": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(0|[1-9][0-9]*|max|now\\+[1-9][0-9]*)$", "not": { "pattern": "[\r\n\u0085\u2028\u2029]" } }
      ]
    },
    "TempoFeePayerCall": {
      "type": "object",
      "required": ["to", "value", "data"],
      "additionalProperties": false,
      "properties": {
        "to": { "$ref": "#/$defs/HexValue" },
        "value": { "$ref": "#/$defs/UintValue" },
        "data": { "$ref": "#/$defs/HexValue" }
      }
    },
    "TempoFeePayerTransaction": {
      "type": "object",
      "required": [
        "chainId",
        "maxPriorityFeePerGas",
        "maxFeePerGas",
        "gasLimit",
        "calls",
        "accessList",
        "nonceKey",
        "nonce",
        "validBefore",
        "feeToken"
      ],
      "additionalProperties": false,
      "properties": {
        "chainId": { "$ref": "#/$defs/UintValue" },
        "maxPriorityFeePerGas": { "$ref": "#/$defs/UintValue" },
        "maxFeePerGas": { "$ref": "#/$defs/UintValue" },
        "gasLimit": { "$ref": "#/$defs/UintValue" },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TempoFeePayerCall" }
        },
        "accessList": {
          "type": "array",
          "items": true
        },
        "nonceKey": { "$ref": "#/$defs/UintValue" },
        "nonce": { "$ref": "#/$defs/UintValue" },
        "validBefore": { "$ref": "#/$defs/UintValue" },
        "feeToken": {
          "anyOf": [
            { "$ref": "#/$defs/HexValue" },
            { "type": "null" }
          ]
        }
      }
    },
    "TempoFeePayerCosignInput": {
      "type": "object",
      "required": ["payerPrivateKey", "feePayerPrivateKey", "feeToken", "request", "transaction"],
      "additionalProperties": false,
      "properties": {
        "payerPrivateKey": { "$ref": "#/$defs/HexValue" },
        "feePayerPrivateKey": { "$ref": "#/$defs/HexValue" },
        "feeToken": { "$ref": "#/$defs/HexValue" },
        "challenge": { "$ref": "#/$defs/Challenge" },
        "request": { "$ref": "#/$defs/JsonObject" },
        "transaction": { "$ref": "#/$defs/TempoFeePayerTransaction" }
      }
    },
    "TempoFeePayerCosignOutput": {
      "type": "object",
      "required": ["type", "feeToken", "feePayerSignaturePresent", "accessListLength", "callCount"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "0x76" },
        "feeToken": { "$ref": "#/$defs/HexValue" },
        "feePayerSignaturePresent": { "type": "boolean" },
        "accessListLength": { "type": "integer", "minimum": 0 },
        "callCount": { "type": "integer", "minimum": 0 }
      }
    },
    "TempoReceiptVerificationInput": {
      "type": "object",
      "required": ["credential", "receipt"],
      "additionalProperties": false,
      "properties": {
        "credential": { "$ref": "#/$defs/Credential" },
        "receipt": { "$ref": "#/$defs/JsonObject" }
      }
    },
    "TempoReceiptVerificationOutput": {
      "type": "object",
      "required": ["status", "reference"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "const": "success" },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "TempoProofVerificationInput": {
      "type": "object",
      "required": ["credential"],
      "additionalProperties": false,
      "properties": {
        "credential": { "$ref": "#/$defs/Credential" },
        "accessKeys": {
          "type": "array",
          "description": "AccountKeychain entries the fake node holds; any other key reads as the zero key (expiry 0).",
          "items": { "$ref": "#/$defs/TempoAccessKeyFixture" }
        }
      }
    },
    "TempoAccessKeyFixture": {
      "type": "object",
      "required": ["account", "accessKey", "expiry", "revoked"],
      "additionalProperties": false,
      "properties": {
        "account": { "$ref": "#/$defs/Address" },
        "accessKey": { "$ref": "#/$defs/Address" },
        "expiry": { "type": "integer", "minimum": 0, "description": "Unix seconds." },
        "revoked": { "type": "boolean" }
      }
    }
  }
}
